{
  "name": "grooming-cycle",
  "description": "Automated issue grooming workflow (discovery → retrospective)",
  "version": "1.0.0",
  "argument_hint": "",

  "phases": [
    {
      "id": "setup",
      "name": "Setup",
      "description": "Initialize grooming session state and validate environment",
      "prompt": "setup.md",
      "timeout": 120000,
      "automation_level": "full",
      "skippable": false,
      "pre_instructions_support": false,
      "blocking_gates": []
    },
    {
      "id": "discovery",
      "name": "Discovery",
      "description": "Find grooming candidates using intelligent prioritization",
      "prompt": "discovery.md",
      "timeout": 300000,
      "automation_level": "full",
      "pre_instructions_support": false,
      "skippable": false,
      "blocking_gates": []
    },
    {
      "id": "processing",
      "name": "Processing",
      "description": "Execute autonomous decisions based on confidence levels",
      "prompt": "processing.md",
      "timeout": 600000,
      "automation_level": "full",
      "pre_instructions_support": false,
      "skippable": false,
      "blocking_gates": []
    },
    {
      "id": "retrospective",
      "name": "Retrospective",
      "description": "Analyze session effectiveness and generate improvements",
      "prompt": "retrospective.md",
      "timeout": 300000,
      "automation_level": "full",
      "pre_instructions_support": false,
      "skippable": false,
      "blocking_gates": []
    }
  ],

  "transitions": {
    "setup": "discovery",
    "discovery": "processing",
    "processing": "retrospective",
    "retrospective": {
      "condition": "CONTINUOUS == 'true'",
      "if_true": "discovery",
      "if_false": null
    }
  },

  "state": {
    "file_pattern": ".groom-state",
    "required_fields": ["PHASE"],
    "optional_fields": ["CONTINUOUS", "SLEEP", "WORKFLOW", "STARTED_AT"],
    "workspace_detection": "auto"
  },

  "error_handling": {
    "on_phase_failure": "log_and_stop",
    "retry_strategy": "manual",
    "friction_log": "tmp/grooming-friction.md"
  },

  "integrations": {
    "github": {
      "issue_claiming": false,
      "pr_creation": false,
      "label_management": true
    },
    "git": {
      "branch_creation": false,
      "auto_commit": false
    }
  }
}
