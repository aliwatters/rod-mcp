{
  "name": "pr-ready-cycle",
  "description": "Automated PR preparation workflow (discovery → complete)",
  "version": "1.0.0",
  "argument_hint": "",

  "phases": [
    {
      "id": "discovery",
      "name": "Discovery",
      "description": "Find PRs needing work (draft, ready for robots, ready for humans)",
      "prompt": "discovery.md",
      "timeout": 300000,
      "automation_level": "full",
      "pre_instructions_support": false,
      "skippable": false,
      "blocking_gates": []
    },
    {
      "id": "preparation",
      "name": "Preparation",
      "description": "Resolve conflicts, fix lint, run tests, merge main",
      "prompt": "prepare-for-humans.md",
      "timeout": 600000,
      "automation_level": "semi_automated",
      "pre_instructions_support": false,
      "skippable": false,
      "blocking_gates": ["conflicts_resolved", "tests_passing"]
    },
    {
      "id": "verification",
      "name": "Verification",
      "description": "Validate all readiness criteria, add verified label",
      "prompt": "verification.md",
      "timeout": 300000,
      "automation_level": "full",
      "pre_instructions_support": false,
      "skippable": false,
      "blocking_gates": ["all_checks_passed"]
    },
    {
      "id": "complete",
      "name": "Complete",
      "description": "Move to next PR or exit",
      "prompt": "complete.md",
      "timeout": 120000,
      "automation_level": "full",
      "pre_instructions_support": false,
      "skippable": false,
      "blocking_gates": []
    }
  ],

  "transitions": {
    "discovery": "preparation",
    "preparation": "verification",
    "verification": "complete",
    "complete": null
  },

  "state": {
    "file_pattern": ".prready-state",
    "required_fields": ["PHASE"],
    "optional_fields": ["PR", "CONTINUOUS", "SLEEP", "WORKFLOW", "STARTED_AT"],
    "workspace_detection": "auto"
  },

  "error_handling": {
    "on_phase_failure": "log_and_stop",
    "retry_strategy": "manual",
    "friction_log": "tmp/pr-ready-friction.md"
  },

  "integrations": {
    "github": {
      "issue_claiming": false,
      "pr_creation": false,
      "label_management": true
    },
    "git": {
      "branch_creation": false,
      "auto_commit": false
    }
  }
}
